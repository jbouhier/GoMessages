---
// One button that offers the right file for the visitor's computer.
// Without JavaScript, or on a phone, it goes to the download page.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/jbouhier/GoMessages/releases/latest/download';
---

<a
  class:list={['gm-btn primary', className]}
  href={`${base}/downloads/`}
  data-gm-download
  data-repo={repo}
>
  <svg viewBox="0 0 20 20" aria-hidden="true">
    <path d="M10 3v9.5m0 0 4-4m-4 4-4-4M4 15.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span data-label>Download</span>
</a>

<script>
  const files = {
    mac: { label: 'Download for Mac', file: 'GoMessages-macos-aarch64.dmg' },
    windows: { label: 'Download for Windows', file: 'GoMessages-windows-x86_64.zip' },
    linux: { label: 'Download for Linux', file: 'GoMessages-linux-x86_64.tar.gz' },
  } as const;

  function detect(): keyof typeof files | null {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string; mobile?: boolean } };
    if (nav.userAgentData?.mobile) return null;
    const p = (nav.userAgentData?.platform || navigator.platform || navigator.userAgent).toLowerCase();
    const ua = navigator.userAgent.toLowerCase();
    if (/android|iphone|ipad|ipod/.test(ua)) return null;
    if (p.includes('mac')) return 'mac';
    if (p.includes('win')) return 'windows';
    if (p.includes('linux') || p.includes('x11')) return 'linux';
    return null;
  }

  const os = detect();
  if (os) {
    for (const el of document.querySelectorAll<HTMLAnchorElement>('[data-gm-download]')) {
      el.href = `${el.dataset.repo}/${files[os].file}`;
      const label = el.querySelector('[data-label]');
      if (label) label.textContent = files[os].label;
    }
  }
</script>
