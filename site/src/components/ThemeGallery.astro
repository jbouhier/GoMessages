---
// Live theme picker. Reads the app's own theme files, so a new theme in
// frontend/src/themes shows up here once it has screenshots.
interface Palette { base: string; mantle: string; accent: string; text: string }
interface Theme { id: string; name: string; order?: number; credit?: string; light: Palette; dark: Palette }

const files = import.meta.glob<{ default: Theme }>('../../../frontend/src/themes/*.json', { eager: true });
const themes = Object.entries(files)
  .filter(([path]) => !path.endsWith('theme.schema.json'))
  .map(([, mod]) => mod.default)
  .filter((t) => t.light && t.dark)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (id: string, mode: string) => `${base}/product/windows/${id}-${mode}.webp`;
const first = themes[0];
---

<div class="gm-themes not-content" data-gm-themes>
  <div class="bar">
    <div class="chips" role="radiogroup" aria-label="Theme">
      {themes.map((t, i) => (
        <button
          type="button"
          role="radio"
          aria-checked={i === 0 ? 'true' : 'false'}
          data-id={t.id}
          data-name={t.name}
          data-credit={t.credit ?? ''}
          style={`--l-base:${t.light.base};--l-accent:${t.light.accent};--d-base:${t.dark.base};--d-accent:${t.dark.accent}`}
        >
          <span class="swatch" aria-hidden="true"></span>
          {t.name}
        </button>
      ))}
    </div>
  </div>

  <figure class="stage" style={`--glow-l:${first.light.accent};--glow-d:${first.dark.accent}`}>
    <div class="compare" style="--pos: 50%">
      <img data-shot="dark" src={src(first.id, 'dark')} alt={`${first.name} theme, dark side`} width="1600" height="1000" loading="lazy" draggable="false" />
      <img data-shot="light" class="light" src={src(first.id, 'light')} alt={`${first.name} theme, light side`} width="1600" height="1000" loading="lazy" draggable="false" />
      <span class="tag l" aria-hidden="true">Light</span>
      <span class="tag d" aria-hidden="true">Dark</span>
      <div class="divider" aria-hidden="true">
        <span class="knob">
          <svg viewBox="0 0 20 20"><path d="M7.5 6 3.5 10l4 4M12.5 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </div>
      <input class="range" type="range" min="0" max="100" step="1" value="50" aria-label="Compare the light and dark sides" aria-valuetext="50% light" />
    </div>
    <figcaption><strong data-cap-name>{first.name}</strong> <span data-cap-credit>{first.credit ?? ''}</span></figcaption>
  </figure>

  {/* Theme accents for the glow, keyed by id and side. */}
  <script type="application/json" data-accents set:html={JSON.stringify(Object.fromEntries(themes.map((t) => [t.id, { light: t.light.accent, dark: t.dark.accent }])))} />
  <span hidden data-src-pattern={src('{id}', '{mode}')}></span>
</div>

<style>
  .gm-themes {
    margin-top: 1.5rem;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  button {
    font: inherit;
    cursor: pointer;
    border: 0;
  }
  .chips button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding: 0 0.875rem 0 0.4375rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    background: var(--gm-surface0);
    box-shadow: inset 0 0 0 1px transparent;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }
  .chips button:hover {
    background: var(--gm-hover);
    color: var(--sl-color-white);
  }
  .chips button[aria-checked='true'] {
    background: var(--gm-base);
    color: var(--sl-color-white);
    font-weight: 600;
    box-shadow: inset 0 0 0 1.5px var(--gm-accent);
  }
  .swatch {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--l-accent) 50%, var(--d-accent) 50%);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--gm-base) 35%, transparent), 0 0 0 1px var(--gm-edge);
  }

  button:focus-visible {
    outline: 2px solid var(--gm-accent);
    outline-offset: 2px;
  }

  .stage {
    position: relative;
    margin: 0;
  }
  .stage::before {
    content: '';
    position: absolute;
    inset: 8% 6% -4%;
    z-index: -1;
    background: linear-gradient(90deg, var(--glow-l), var(--glow-d));
    filter: blur(70px);
    opacity: 0.32;
    border-radius: 50%;
  }
  .compare {
    position: relative;
    aspect-ratio: 1600 / 1000;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--gm-shadow);
    background: var(--gm-surface0);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .compare::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--gm-edge);
    pointer-events: none;
  }
  .compare img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  .compare img.light {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12), 0 0 12px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }
  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    color: #1f1f1f;
    background: rgba(255, 255, 255, 0.92);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08), 0 6px 18px rgba(0, 0, 0, 0.28);
    transition: transform 0.15s;
  }
  .knob svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .compare.dragging .knob,
  .compare:hover .knob {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .compare:has(.range:focus-visible) .knob {
    outline: 2px solid var(--gm-accent);
    outline-offset: 3px;
  }
  .tag {
    position: absolute;
    bottom: 0.875rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    pointer-events: none;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: opacity 0.2s;
  }
  .tag.l {
    left: 0.875rem;
    color: #1f1f1f;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06);
    opacity: var(--l-op, 1);
  }
  .tag.d {
    right: 0.875rem;
    color: #fff;
    background: rgba(20, 20, 24, 0.55);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
    opacity: var(--d-op, 1);
  }
  /* Visually hidden, still focusable: the keyboard and screen readers use it. */
  .range {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  figcaption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--gm-subtext);
    text-align: center;
  }
  figcaption strong {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: -1rem;
      padding: 2px 1rem;
      scrollbar-width: none;
    }
    .chips button {
      flex: none;
    }
    .knob {
      width: 2.25rem;
      height: 2.25rem;
    }
    .tag {
      bottom: 0.5rem;
      font-size: 0.6875rem;
    }
    .tag.l { left: 0.5rem; }
    .tag.d { right: 0.5rem; }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-gm-themes]')) {
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const compare = root.querySelector<HTMLElement>('.compare')!;
    const range = root.querySelector<HTMLInputElement>('.range')!;
    const darkImg = root.querySelector<HTMLImageElement>('[data-shot="dark"]')!;
    const lightImg = root.querySelector<HTMLImageElement>('[data-shot="light"]')!;
    const nameEl = root.querySelector('[data-cap-name]')!;
    const creditEl = root.querySelector('[data-cap-credit]')!;
    const pattern = root.querySelector<HTMLElement>('[data-src-pattern]')!.dataset.srcPattern!;
    const accents = JSON.parse(root.querySelector('[data-accents]')!.textContent!);
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chips button')];

    let id = chips[0].dataset.id!;
    const url = (i: string, m: string) => pattern.replace('{id}', i).replace('{mode}', m);

    function render() {
      const chip = chips.find((c) => c.dataset.id === id)!;
      chips.forEach((c) => c.setAttribute('aria-checked', String(c === chip)));
      darkImg.src = url(id, 'dark');
      lightImg.src = url(id, 'light');
      darkImg.alt = `${chip.dataset.name} theme, dark side`;
      lightImg.alt = `${chip.dataset.name} theme, light side`;
      nameEl.textContent = chip.dataset.name!;
      creditEl.textContent = chip.dataset.credit ?? '';
      stage.style.setProperty('--glow-l', accents[id].light);
      stage.style.setProperty('--glow-d', accents[id].dark);
    }

    // ---- the slider ----
    function setPos(p: number) {
      p = Math.max(0, Math.min(100, p));
      compare.style.setProperty('--pos', `${p}%`);
      // A label fades as its side is covered.
      compare.style.setProperty('--l-op', String(Math.min(1, p / 15)));
      compare.style.setProperty('--d-op', String(Math.min(1, (100 - p) / 15)));
      range.value = String(Math.round(p));
      range.setAttribute('aria-valuetext', `${Math.round(p)}% light`);
    }
    const fromX = (x: number) => {
      const r = compare.getBoundingClientRect();
      return ((x - r.left) / r.width) * 100;
    };
    let intro: Animation | number | null = null;
    const stopIntro = () => { if (typeof intro === 'number') cancelAnimationFrame(intro); intro = null; };

    compare.addEventListener('pointerdown', (e) => {
      stopIntro();
      compare.setPointerCapture(e.pointerId);
      compare.classList.add('dragging');
      setPos(fromX(e.clientX));
    });
    compare.addEventListener('pointermove', (e) => {
      if (compare.hasPointerCapture(e.pointerId)) setPos(fromX(e.clientX));
    });
    const end = (e: PointerEvent) => {
      if (compare.hasPointerCapture(e.pointerId)) compare.releasePointerCapture(e.pointerId);
      compare.classList.remove('dragging');
    };
    compare.addEventListener('pointerup', end);
    compare.addEventListener('pointercancel', end);
    range.addEventListener('input', () => { stopIntro(); setPos(Number(range.value)); });

    // A short sweep the first time it's seen, so people know it moves.
    function playIntro() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const keys = [[0, 50], [450, 68], [1100, 32], [1600, 50]];
      const t0 = performance.now();
      const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
      const step = (now: number) => {
        const t = now - t0;
        let k = 1;
        while (k < keys.length - 1 && t > keys[k][0]) k++;
        const [ta, pa] = keys[k - 1], [tb, pb] = keys[k];
        const f = Math.min(1, Math.max(0, (t - ta) / (tb - ta)));
        setPos(pa + (pb - pa) * ease(f));
        intro = t < keys[keys.length - 1][0] ? requestAnimationFrame(step) : null;
      };
      intro = requestAnimationFrame(step);
    }

    chips.forEach((c, i) => {
      c.addEventListener('click', () => { id = c.dataset.id!; render(); });
      c.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const next = chips[(i + d + chips.length) % chips.length];
        next.focus();
        next.click();
      });
    });

    // Warm the cache so switching feels instant, and sweep once in view.
    const warm = () => chips.forEach((c) => ['light', 'dark'].forEach((m) => { new Image().src = url(c.dataset.id!, m); }));
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) { warm(); obs.disconnect(); }
    }, { rootMargin: '200px' }).observe(root);
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) { setTimeout(playIntro, 250); obs.disconnect(); }
    }, { threshold: 0.6 }).observe(compare);

    setPos(50);
    render();
  }
</script>
