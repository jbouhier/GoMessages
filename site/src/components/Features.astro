---
// Landing page feature grid. Edit the copy here.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
import Illustration from './Illustration.astro';
const shot = (n: string) => `${base}/product/windows/feature-${n}.webp`;
---

<div class="gm-bento not-content">
  <article class="card wide">
    <div class="text">
      <h3>Jump to anyone</h3>
      <p><kbd>⌘</kbd><kbd>K</kbd></p>
    </div>
    <div class="media" style="--pos: 25% 0%">
      <img src={shot('quick-switcher')} alt="The quick switcher, opened with Cmd+K" width="1600" height="1000" loading="lazy" />
    </div>
  </article>

  <article class="card">
    <div class="text">
      <h3>A shortcut for everything</h3>
      <p><kbd>⌘</kbd><kbd>/</kbd></p>
    </div>
    <div class="media" style="--pos: 100% 0%">
      <img src={shot('shortcuts')} alt="The keyboard shortcuts list" width="1600" height="1000" loading="lazy" />
    </div>
  </article>

  <article class="card">
    <div class="text">
      <h3>Photos, full size</h3>
    </div>
    <div class="media" style="--pos: 50% 30%">
      <img src={shot('photos')} alt="A photo opened full size" width="1600" height="1000" loading="lazy" />
    </div>
  </article>

  <article class="card">
    <div class="text">
      <h3>Make it yours</h3>
    </div>
    <div class="media" style="--pos: 100% 0%">
      <img src={shot('settings')} alt="Appearance settings with the theme picker" width="1600" height="1000" loading="lazy" />
    </div>
  </article>

  <article class="card privacy">
    <div class="text">
      <h3>Private by default</h3>
      <p>No telemetry. Open source.</p>
    </div>
    <div class="ill"><Illustration name="privacy" /></div>
  </article>

  <article class="card everything">
    <div class="text">
      <h3>And everything else</h3>
    </div>
    <ul class="tags">
      <li>Photos and files</li>
      <li>Reactions</li>
      <li>Replies</li>
      <li>Typing indicators</li>
      <li>Archive</li>
      <li>Search</li>
      <li>New chats from contacts</li>
      <li>Notifications</li>
      <li>Mute per chat</li>
      <li>RCS and SMS</li>
    </ul>
  </article>
</div>

<style>
  .gm-bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 22rem;
    border-radius: 20px;
    background: var(--gm-mantle);
    box-shadow: inset 0 0 0 1px var(--gm-edge);
    overflow: hidden;
  }
  .card.wide {
    grid-column: span 2;
  }
  .card.everything {
    grid-column: 1 / -1;
    min-height: 0;
  }
  .text {
    padding: 1.5rem 1.5rem 0;
  }
  h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  p {
    margin: 0.375rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--gm-subtext);
    max-width: 30rem;
  }
  kbd {
    display: inline-block;
    min-width: 1.5em;
    margin-inline-end: 0.15em;
    padding: 0 0.35em;
    font: 600 0.8125rem/1.6 var(--__sl-font);
    text-align: center;
    color: var(--sl-color-white);
    background: var(--gm-base);
    border: 1px solid var(--sl-color-hairline-light);
    border-bottom-width: 2px;
    border-radius: 6px;
  }
  .media {
    position: relative;
    flex: 1;
    margin: 1.5rem 0 0 1.5rem;
    min-height: 13rem;
    border-radius: 12px 0 0 0;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--gm-edge);
  }
  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 0 0);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .wide .media img {
    object-fit: cover;
  }
  .card:hover .media img {
    transform: scale(1.025);
  }

  .ill {
    margin: auto 0 0;
    padding: 1rem 1.5rem 1.5rem;
  }
  .card.privacy {
    min-height: 22rem;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 1rem 1.5rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags li {
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    background: var(--gm-base);
    box-shadow: inset 0 0 0 1px var(--gm-edge);
  }

  @media (max-width: 56rem) {
    .gm-bento {
      grid-template-columns: 1fr 1fr;
    }
    .card.wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 40rem) {
    .gm-bento {
      grid-template-columns: 1fr;
    }
    .card.wide,
    .card.everything {
      grid-column: auto;
    }
    .card {
      min-height: 19rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .media img {
      transition: none;
    }
  }
</style>
