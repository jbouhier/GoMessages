---
// Editorial spot illustrations: ink line over a soft color field.
// Colors follow the site's light and dark mode.
interface Props {
  name: 'download' | 'signin' | 'pair' | 'privacy';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class:list={['gm-ill', `tint-${name}`, className]} viewBox="0 0 240 160" aria-hidden="true">
  {name === 'download' && (
    <g>
      <ellipse class="field" cx="128" cy="92" rx="78" ry="54" />
      <circle class="dot" cx="52" cy="40" r="5" />
      <!-- laptop -->
      <rect class="paper ink" x="62" y="70" width="116" height="66" rx="7" />
      <path class="ink" d="M48 140h144l-8 8H56z" />
      <rect class="soft" x="72" y="80" width="40" height="46" rx="3" />
      <rect class="accent" x="120" y="88" width="46" height="9" rx="4.5" />
      <rect class="softer" x="120" y="104" width="34" height="9" rx="4.5" />
      <!-- arrow -->
      <path class="ink thick" d="M120 14v42" />
      <path class="ink thick" d="M104 42l16 16 16-16" />
    </g>
  )}

  {name === 'signin' && (
    <g>
      <ellipse class="field" cx="116" cy="84" rx="82" ry="56" />
      <circle class="dot" cx="196" cy="34" r="5" />
      <rect class="paper ink" x="58" y="26" width="124" height="112" rx="12" />
      <circle class="soft ink" cx="120" cy="62" r="16" />
      <path class="ink" d="M112 66c4 4 12 4 16 0" />
      <circle class="inkfill" cx="114" cy="58" r="1.8" />
      <circle class="inkfill" cx="126" cy="58" r="1.8" />
      <rect class="accent" x="76" y="96" width="88" height="22" rx="11" />
      <circle class="paper" cx="90" cy="107" r="5" />
      <rect class="paper" x="100" y="104.5" width="50" height="5" rx="2.5" />
    </g>
  )}

  {name === 'pair' && (
    <g>
      <ellipse class="field" cx="120" cy="86" rx="84" ry="54" />
      <!-- phone -->
      <rect class="paper ink" x="136" y="22" width="62" height="118" rx="12" />
      <rect class="inkfill" x="158" y="28" width="18" height="4" rx="2" />
      <circle class="softer ink" cx="152" cy="64" r="9" />
      <circle class="accent ink" cx="167" cy="88" r="11" />
      <circle class="softer ink" cx="182" cy="64" r="9" />
      <path class="paperline" d="M162 90c3 3 7 3 10 0" />
      <circle class="paperfill" cx="163" cy="85" r="1.6" />
      <circle class="paperfill" cx="171" cy="85" r="1.6" />
      <!-- small laptop -->
      <rect class="paper ink" x="34" y="84" width="64" height="40" rx="5" />
      <path class="ink" d="M26 128h80l-5 5H31z" />
      <circle class="accent" cx="66" cy="104" r="8" />
      <!-- link -->
      <path class="ink dash" d="M100 92c14-20 26-24 36-26" />
    </g>
  )}

  {name === 'privacy' && (
    <g>
      <ellipse class="field" cx="120" cy="86" rx="88" ry="52" />
      <path class="ink dash" d="M54 92h132" />
      <!-- computer -->
      <rect class="paper ink" x="26" y="70" width="46" height="34" rx="5" />
      <path class="ink" d="M40 112h18" />
      <!-- phone -->
      <rect class="paper ink" x="176" y="62" width="28" height="50" rx="6" />
      <!-- lock -->
      <path class="ink thick" d="M108 74v-10a12 12 0 0 1 24 0v10" />
      <rect class="accent ink" x="98" y="72" width="44" height="40" rx="8" />
      <circle class="paperfill" cx="120" cy="88" r="4" />
      <path class="paperline" d="M120 91v8" />
      <circle class="dot" cx="196" cy="36" r="5" />
    </g>
  )}
</svg>

<style>
  .gm-ill {
    display: block;
    width: 100%;
    height: auto;
    --ink: #1f1f1f;
    --paper: #ffffff;
    --accent: #0b57d0;
    --soft: #d3e3fd;
    --softer: #e9eef6;
    --field: #e3ebff;
  }
  .tint-signin { --field: #efe3f6; }
  .tint-pair { --field: #fde9de; }
  .tint-privacy { --field: #dcf1ea; }

  :global([data-theme='dark']) .gm-ill {
    --ink: #e3e3e3;
    --paper: #1b1b1d;
    --accent: #a8c7fa;
    --soft: #004a77;
    --softer: #2a2b2e;
    --field: #1a2647;
  }
  :global([data-theme='dark']) .tint-signin { --field: #2c1f45; }
  :global([data-theme='dark']) .tint-pair { --field: #3a231c; }
  :global([data-theme='dark']) .tint-privacy { --field: #15342d; }

  .field { fill: var(--field); }
  .dot { fill: var(--accent); opacity: 0.35; }
  .paper { fill: var(--paper); }
  .soft { fill: var(--soft); }
  .softer { fill: var(--softer); }
  .accent { fill: var(--accent); }
  .inkfill { fill: var(--ink); }
  .paperfill { fill: var(--paper); }
  .ink {
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  path.ink:not(.paper) { fill: none; }
  path.ink[d$='z'] { fill: var(--paper); }
  .thick { stroke-width: 2.4; }
  .dash { stroke-dasharray: 2 5; }
  .paperline {
    fill: none;
    stroke: var(--paper);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
</style>
