---
const repo = 'https://github.com/jbouhier/GoMessages/releases/latest/download';
const items = [
  { name: 'Mac', note: 'Apple Silicon', file: 'GoMessages-macos-aarch64.dmg' },
  { name: 'Windows', note: '10 and 11', file: 'GoMessages-windows-x86_64.zip' },
  { name: 'Linux', note: 'x64', file: 'GoMessages-linux-x86_64.tar.gz' },
];
---

<ul class="gm-dl not-content">
  {items.map((i) => (
    <li>
      <a class="gm-btn primary" href={`${repo}/${i.file}`} title={i.file}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9.5m0 0 4-4m-4 4-4-4M4 15.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {i.name}
      </a>
      <span class="note">{i.note}</span>
    </li>
  ))}
</ul>

<style>
  .gm-dl {
    list-style: none;
    margin: 1.75rem 0 2.25rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin: 0;
  }
  .gm-btn {
    justify-content: center;
    height: 3rem;
  }
  .note {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--gm-subtext);
  }
  @media (max-width: 40rem) {
    .gm-dl {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
