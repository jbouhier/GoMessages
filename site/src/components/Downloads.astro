---
const repo = 'https://github.com/jbouhier/GoMessages/releases/latest/download';
const items = [
  { os: 'mac', name: 'Mac', note: 'Apple Silicon', file: 'GoMessages-macos-aarch64.dmg' },
  { os: 'windows', name: 'Windows', note: 'Windows 10 and 11', file: 'GoMessages-windows-x86_64.zip' },
  { os: 'linux', name: 'Linux', note: 'x64', file: 'GoMessages-linux-x86_64.tar.gz' },
];
---

<ul class="gm-dl not-content">
  {items.map((i) => (
    <li>
      <a href={`${repo}/${i.file}`} data-os={i.os} title={i.file}>
        <span class="name">{i.name}</span>
        <span class="note">{i.note}</span>
        <span class="go" aria-hidden="true">
          <svg viewBox="0 0 20 20"><path d="M10 3.5v9m0 0 3.75-3.75M10 12.5 6.25 8.75M4.5 16h11" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .gm-dl {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    border-radius: 14px;
    border: 1px solid var(--sl-color-hairline-light);
    overflow: hidden;
  }
  li + li {
    border-top: 1px solid var(--sl-color-hairline-light);
  }
  a {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    transition: background 0.12s;
  }
  a:hover {
    background: var(--gm-hover);
  }
  a:focus-visible {
    outline: 2px solid var(--gm-accent);
    outline-offset: -2px;
  }
  .name {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .note {
    font-size: 0.875rem;
    color: var(--gm-subtext);
  }
  .go {
    align-self: center;
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--gm-subtext);
    transition: background 0.12s, color 0.12s;
  }
  .go svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  a:hover .go,
  .mine .go {
    color: var(--gm-on-accent);
    background: var(--gm-accent);
  }
</style>

<script>
  const ua = navigator.userAgent.toLowerCase();
  const p = ((navigator as any).userAgentData?.platform || navigator.platform || ua).toLowerCase();
  const os = /android|iphone|ipad/.test(ua) ? null : p.includes('mac') ? 'mac' : p.includes('win') ? 'windows' : p.includes('linux') ? 'linux' : null;
  if (os) {
    const a = document.querySelector<HTMLElement>(`.gm-dl [data-os="${os}"]`);
    if (a) {
      a.classList.add('mine');
      a.parentElement!.parentElement!.prepend(a.parentElement!);
    }
  }
</script>
