---
const repo = 'https://github.com/jbouhier/GoMessages/releases/latest/download';
const items = [
  { os: 'mac', name: 'Mac', note: 'Apple Silicon', file: 'GoMessages-macos-aarch64.dmg' },
  { os: 'windows', name: 'Windows', note: '10 and 11', file: 'GoMessages-windows-x86_64.zip' },
  { os: 'linux', name: 'Linux', note: 'x64', file: 'GoMessages-linux-x86_64.tar.gz' },
];
---

<ul class="gm-dl not-content">
  {items.map((i) => (
    <li>
      <a href={`${repo}/${i.file}`} data-os={i.os} title={i.file}>
        <span class="name">{i.name}</span>
        <span class="note">{i.note}</span>
        <span class="go">
          Download
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v9m0 0 3.5-3.5M10 13 6.5 9.5M5 16h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .gm-dl {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--sl-color-hairline-light);
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }
  li + li {
    border-left: 1px solid var(--sl-color-hairline-light);
  }
  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem 1.5rem 1.5rem;
    text-decoration: none;
    transition: background 0.15s;
  }
  a:hover {
    background: var(--gm-mantle);
  }
  a:focus-visible {
    outline: 2px solid var(--gm-accent);
    outline-offset: -2px;
  }
  .name {
    font-size: 1.75rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
  }
  .note {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--gm-subtext);
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 2.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gm-accent);
  }
  .go svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s;
  }
  a:hover .go svg {
    transform: translateY(2px);
  }
  @media (max-width: 48rem) {
    .gm-dl {
      grid-template-columns: 1fr;
    }
    li + li {
      border-left: 0;
      border-top: 1px solid var(--sl-color-hairline-light);
    }
    a {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
      padding: 1.25rem 0.25rem;
    }
    .name {
      font-size: 1.375rem;
    }
    .note {
      margin-top: 0;
    }
    .go {
      margin: 0 0 0 auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .go svg { transition: none; }
  }
</style>

