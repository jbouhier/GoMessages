---
import Illustration from './Illustration.astro';

const repo = 'https://github.com/jbouhier/GoMessages/releases/latest/download';
const items = [
  { os: 'mac', name: 'Mac', note: 'Apple Silicon', file: 'GoMessages-macos-aarch64.dmg' },
  { os: 'windows', name: 'Windows', note: '10 and 11', file: 'GoMessages-windows-x86_64.zip' },
  { os: 'linux', name: 'Linux', note: 'x64', file: 'GoMessages-linux-x86_64.tar.gz' },
] as const;
---

<ul class="gm-dl not-content">
  {items.map((i) => (
    <li>
      <a href={`${repo}/${i.file}`} data-os={i.os} title={i.file}>
        <Illustration name={i.os} />
        <span class="meta">
          <span class="name">{i.name}</span>
          <span class="note">{i.note}</span>
        </span>
        <span class="go">
          Download
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v9m0 0 3.5-3.5M10 13 6.5 9.5M5 16h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .gm-dl {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.75rem 0.75rem 1.125rem;
    border-radius: 18px;
    text-decoration: none;
    background: var(--gm-mantle);
    box-shadow: inset 0 0 0 1px var(--gm-edge);
    transition: box-shadow 0.15s, transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  a:hover {
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 1px var(--gm-edge), 0 14px 30px -18px rgba(0, 0, 0, 0.45);
  }
  a:focus-visible {
    outline: 2px solid var(--gm-accent);
    outline-offset: 2px;
  }
  a.mine {
    box-shadow: inset 0 0 0 1.5px var(--gm-accent);
  }
  .meta {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0.75rem 0.5rem 0;
  }
  .name {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .note {
    font-size: 0.8125rem;
    color: var(--gm-subtext);
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0.5rem 0.5rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gm-accent);
  }
  .go svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s;
  }
  a:hover .go svg {
    transform: translateY(2px);
  }
  @media (max-width: 48rem) {
    .gm-dl {
      grid-template-columns: 1fr;
    }
    a {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      padding: 0.5rem 1rem 0.5rem 0.5rem;
    }
    a :global(.gm-ill) {
      width: 7.5rem;
      flex: none;
    }
    .meta {
      flex-direction: column;
      gap: 0.125rem;
      margin: 0 0 0 0.5rem;
    }
    .go {
      margin: 0 0 0 auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    a, .go svg { transition: none; }
  }
</style>

<script>
  const ua = navigator.userAgent.toLowerCase();
  const p = ((navigator as any).userAgentData?.platform || navigator.platform || ua).toLowerCase();
  const os = /android|iphone|ipad/.test(ua) ? null : p.includes('mac') ? 'mac' : p.includes('win') ? 'windows' : p.includes('linux') ? 'linux' : null;
  if (os) {
    const a = document.querySelector<HTMLElement>(`.gm-dl [data-os="${os}"]`);
    if (a) {
      a.classList.add('mine');
      a.parentElement!.parentElement!.prepend(a.parentElement!);
    }
  }
</script>
